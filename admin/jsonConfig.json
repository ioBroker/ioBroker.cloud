{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_options": {
            "type": "panel",
            "label": "Options",
            "items": {
                "useCredentials": {
                    "type": "checkbox",
                    "label": "Use login and password",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "server": {
                    "newLine": true,
                    "type": "select",
                    "label": "Server",
                    "hidden": "!data.useCredentials",
                    "noTranslation": true,
                    "options": [
                        { "label": "iobroker.pro", "value": "iobroker.pro" },
                        { "label": "iobroker.net", "value": "iobroker.net" }
                    ],
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "apikey": {
                    "newLine": true,
                    "hidden": "!!data.useCredentials",
                    "type": "text",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "label": "APP-KEY",
                    "help": "help_tip"
                },
                "credentialType": {
                    "newLine": true,
                    "type": "select",
                    "options": [
                        { "label": "System credentials", "value": "manager" },
                        { "label": "Manual", "value": "manual" }
                    ],
                    "label": "Credentials type",
                    "hidden": "!data.useCredentials",
                    "default": "manual",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "credentialId": {
                    "type": "credential",
                    "label": "Credentials",
                    "hidden": "!data.useCredentials || data.credentialType !== 'manager'",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "login": {
                    "newLine": true,
                    "hidden": "!data.useCredentials || data.credentialType === 'manager'",
                    "type": "text",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "label": "Login"
                },
                "pass": {
                    "hidden": "!data.useCredentials || data.credentialType === 'manager'",
                    "type": "password",
                    "repeat": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "label": "Password"
                },
                "instance": {
                    "newLine": true,
                    "adapter": "web",
                    "type": "instance",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "label": "Web instance"
                },
                "_instanceAlive": {
                    "newLine": true,
                    "type": "alive",
                    "textAlive": "",
                    "instance": "${data.instance}",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_testWeb": {
                    "newLine": true,
                    "type": "sendTo",
                    "command": "testWeb",
                    "label": "Test web",
                    "help": "Checks whether the web instance can be opened via the cloud",
                    "variant": "outlined",
                    "showProcess": true,
                    "timeout": 30000,
                    "jsonData": "{\"instance\": \"${data.instance}\"}",
                    "hidden": "!data.instance",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_testAura": {
                    "newLine": true,
                    "type": "sendTo",
                    "command": "testAura",
                    "label": "Test aura",
                    "help": "Checks whether aura can be opened via the cloud (served by the web instance at /aura/)",
                    "variant": "outlined",
                    "showProcess": true,
                    "timeout": 30000,
                    "jsonData": "{\"instance\": \"${data.instance}\"}",
                    "hidden": "!data.instance",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_qrCodeLabel": {
                    "newLine": true,
                    "type": "header",
                    "size": 4,
                    "text": "QR code for ioBroker.visu app",
                    "help": "Scan this QR code with the ioBroker app to fill in the connection details automatically.",
                    "hidden": "!data.useCredentials || !data.instance || data.server !== 'iobroker.pro'",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_qrCode": {
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "type": "qrCodeSendTo",
                    "command": "qrCode",
                    "sendFirstByClick": true,
                    "tooltip": "Scan this QR code with the ioBroker app to fill in the connection details automatically.",
                    "jsonData": "{\"login\": \"${data.login}\", \"pass\": \"${data.pass}\", \"instance\": \"${data.instance}\", \"credentialType\": \"${data.credentialType}\", \"credentialId\": \"${data.credentialId}\"}",
                    "hidden": "!data.useCredentials || !data.instance || data.server !== 'iobroker.pro'"
                }
            }
        },
        "_advanced": {
            "type": "panel",
            "label": "Extended options",
            "items": {
                "cloudUrl": {
                    "disabled": "(data.useCredentials && data.server === 'iobroker.pro') || (!data.useCredentials && data.apikey.startsWith('@pro_'))",
                    "type": "text",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 3,
                    "label": "Cloud URL"
                },
                "connectionTimeout": {
                    "type": "number",
                    "min": 0,
                    "max": 100000,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 3,
                    "label": "Connection timeout"
                },
                "pingTimeout": {
                    "type": "number",
                    "min": 0,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 3,
                    "xl": 3,
                    "label": "Ping timeout"
                },
                "allowSelfSignedCertificate": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Allow self-signed certificates",
                    "help": "Read more about certificates",
                    "helpLink": "https://github.com/ioBroker/ioBroker.cloud/blob/master/README.md#allow-self-signed-certificates",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "restartOnDisconnect": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Restart on disconnect",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "onlyViewer": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Only viewer mode",
                    "help": "In this mode, the adapter will hide admin and vis editor",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "style": {
                        "marginBottom": "16px"
                    }
                },
                "allowAdmin": {
                    "newLine": true,
                    "type": "instance",
                    "adapter": "admin",
                    "long": true,
                    "allowDeactivate": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "!!data.onlyViewer",
                    "label": "Allow admin access",
                    "help": "only on pro",
                    "disabled": "(data.useCredentials && data.server !== 'iobroker.pro') || (!data.useCredentials && !data.apikey.startsWith('@pro_'))"
                },
                "lovelace": {
                    "type": "instance",
                    "long": true,
                    "adapter": "lovelace",
                    "allowDeactivate": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "label": "Allow lovelace access",
                    "help": "only on pro",
                    "disabled": "(data.useCredentials && data.server !== 'iobroker.pro') || (!data.useCredentials && !data.apikey.startsWith('@pro_'))"
                },
                "_adminAlive": {
                    "newLine": true,
                    "type": "alive",
                    "textAlive": "",
                    "instance": "${data.allowAdmin}",
                    "hidden": "!!data.onlyViewer",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_lovelaceAlive": {
                    "type": "alive",
                    "textAlive": "",
                    "instance": "${data.lovelace}",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_testAdmin": {
                    "newLine": true,
                    "type": "sendTo",
                    "command": "testAdmin",
                    "label": "Test admin",
                    "help": "Checks whether the admin instance can be opened via the cloud",
                    "variant": "outlined",
                    "showProcess": true,
                    "timeout": 30000,
                    "jsonData": "{\"instance\": \"${data.allowAdmin}\", \"pro\": ${(data.useCredentials && data.server === 'iobroker.pro') || (!data.useCredentials && (data.apikey || '').startsWith('@pro_'))}}",
                    "hidden": "!!data.onlyViewer || !data.allowAdmin",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "_testLovelace": {
                    "type": "sendTo",
                    "command": "testLovelace",
                    "label": "Test lovelace",
                    "help": "Checks whether the lovelace instance can be opened via the cloud",
                    "variant": "outlined",
                    "showProcess": true,
                    "timeout": 30000,
                    "jsonData": "{\"instance\": \"${data.lovelace}\", \"pro\": ${(data.useCredentials && data.server === 'iobroker.pro') || (!data.useCredentials && (data.apikey || '').startsWith('@pro_'))}}",
                    "hidden": "!data.lovelace",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_remoteShell": {
            "type": "panel",
            "label": "Remote shell",
            "hidden": true,
            "items": {
                "_sshSettings": {
                    "type": "custom",
                    "i18n": true,
                    "guiApi": 2,
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomCloudSet/Components/SshSettings",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "_services": {
            "type": "panel",
            "label": "Services and IFTTT",
            "items": {
                "iftttKey": {
                    "type": "text",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4,
                    "label": "IFTTT key"
                },
                "_ifttt_link": {
                    "type": "textSendTo",
                    "container": "text",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8,
                    "alsoDependsOn": ["useCredentials", "apikey", "login", "pass", "server"],
                    "label": "Use following link for IFTTT",
                    "command": "getIFTTTLink",
                    "jsonData": "{\"apikey\": \"${data.apikey}\", \"useCredentials\": ${!!data.useCredentials}, \"login\": \"${data.login}\", \"pass\": \"${data.pass}\", \"server\": \"${data.server}\", \"credentialType\": \"${data.credentialType}\", \"credentialId\": \"${data.credentialId}\"}",
                    "copyToClipboard": true
                },
                "allowedServices": {
                    "newLine": true,
                    "type": "chips",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "label": "White list for services"
                },
                "_service_link": {
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8,
                    "type": "textSendTo",
                    "alsoDependsOn": ["useCredentials", "apikey", "login", "pass", "server"],
                    "container": "text",
                    "label": "Use following link for custom service",
                    "command": "getServiceLink",
                    "jsonData": "{\"apikey\": \"${data.apikey}\", \"useCredentials\": ${!!data.useCredentials}, \"login\": \"${data.login}\", \"pass\": \"${data.pass}\", \"server\": \"${data.server}\", \"credentialType\": \"${data.credentialType}\", \"credentialId\": \"${data.credentialId}\"}",
                    "copyToClipboard": true
                },
                "text2command": {
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "short": true,
                    "type": "instance",
                    "adapter": "text2command",
                    "allowDeactivate": true,
                    "label": "Use text2command instance"
                }
            }
        }
    }
}
